FROM dsv41-tf-py:local
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TENSORFOLD_NO_UPDATE_CHECK=1
RUN test -f /usr/include/infiniband/verbs.h
RUN pip uninstall -y tensorfold || true
RUN pip install --no-cache-dir --no-deps transformers==5.18.0 && pip install --no-cache-dir huggingface_hub==1.31.0
COPY build/tensorfold /opt/tensorfold
RUN pip install --no-deps --no-build-isolation /opt/tensorfold && \
    python -c "import torch,triton,tensorfold.families.deepseek_v41; assert triton.__version__=='3.7.1'; assert 'nv26.07' in torch.__version__; print('OK', torch.__version__)"
ENTRYPOINT ["python", "-m", "tensorfold"]
